// ============================================================
// ALOHA Language School — database schema
// Consumed by the future backend. The frontend already reads
// shapes matching these models via `src/types/product.ts` and
// `src/types/common.ts`.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------- Courses -----------------------------

enum CourseLanguage {
  EN
  ZH
  KO
  JA
}

enum CourseLevel {
  HSK1
  HSK2
  HSK3
  HSK4
  HSK5
  HSK6
  IELTS
  TOEIC
  TOPIK1
  TOPIK2
  JLPT_N5
  JLPT_N4
  JLPT_N3
  JLPT_N2
  JLPT_N1
}

enum CourseStatus {
  OPEN
  COMING_SOON
  CLOSED
}

/// A learning program that students can enroll in.
model Course {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  language        CourseLanguage
  level           CourseLevel
  levelLabel      String         // e.g. "HSK 3", "IELTS 6.5+"
  band            String         // e.g. "Tiếng Trung · Sơ – Trung cấp"
  durationMonths  Int
  totalSessions   Int
  target          String         // Who this course is for
  outcome         String         // What students achieve
  syllabus        String[]       // Bullet list
  status          CourseStatus   @default(OPEN)
  gradient        String         // CSS gradient for the card banner
  glyph           String         // Language glyph shown on the card
  featured        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([language, status])
}

// ----------------------- News --------------------------------

model NewsArticle {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String
  content      String   @db.Text
  coverImage   String
  category     String
  author       String
  publishedAt  DateTime
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
}

// ----------------------- Testimonials ------------------------

/// Real ALOHA student results. `scoresJson` stores either
/// { total, max, parts:[{label,score,max}] } for HSK/HSKK, or
/// { overall, bands:[{label,score}] } for IELTS. The FE has
/// matching TypeScript types in `src/types/product.ts`.
model Testimonial {
  id           String   @id @default(cuid())
  name         String
  course       String   // "HSK3", "IELTS 6.5+", ...
  quote        String
  image        String
  scoresJson   Json?
  publishedAt  DateTime @default(now())
}

// ----------------------- Contact leads -----------------------

/// Registrations from the trial-class modal or the contact form.
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  language  String?
  message   String?
  source    String?  // "modal" | "contact-page" | ...
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
