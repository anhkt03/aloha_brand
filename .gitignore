# ============================================================
# Root .gitignore — applies to the whole monorepo (fe/, be/, …)
# ============================================================

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editors / IDEs ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- Next.js (fe/) ----
fe/.next/
fe/out/
fe/build/
fe/next-env.d.ts
fe/*.tsbuildinfo

# ---- Testing / coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Prisma (generated client) ----
**/prisma/generated/
**/node_modules/.prisma/

# ---- Uploads (local) ----
uploads/
tmp/

# ---- Deploy ----
.vercel/
.turbo/

# ---- Misc ----
*.pem
*.tgz
.cache/
