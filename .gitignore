# ============================================================
# ALOHA — .gitignore
# Single Next.js project (FE + BE via API routes)
# ============================================================

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- Editors ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.sw?

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- Next.js ----
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ---- Testing / coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Prisma (generated) ----
prisma/generated/
node_modules/.prisma/

# ---- Uploads / local storage ----
uploads/
tmp/

# ---- Deploy / cache ----
.vercel/
.turbo/
.cache/

# ---- Misc ----
*.pem
*.tgz
