generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CourseStatus {
  OPEN
  COMING_SOON
  CLOSED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentType {
  TRIAL
  REAL
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserRole {
  ADMIN
  STAFF
}

model CourseType {
  id           Int                     @id @default(autoincrement())
  iconUrl      String?                 @map("icon_url")
  sortOrder    Int                     @default(0) @map("sort_order")
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  courses      Course[]
  levels       CourseLevel[]
  translations CourseTypeTranslation[]

  @@map("course_types")
}

model CourseTypeTranslation {
  id           Int        @id @default(autoincrement())
  courseTypeId Int        @map("course_type_id")
  locale       String
  name         String

  courseType   CourseType @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)

  @@unique([courseTypeId, locale])
  @@index([locale])
  @@map("course_type_translations")
}

model CourseLevel {
  id           Int                      @id @default(autoincrement())
  courseTypeId Int                      @map("course_type_id")
  name         String
  sortOrder    Int                      @default(0) @map("sort_order")
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  courseType   CourseType               @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  courses      Course[]
  translations CourseLevelTranslation[]

  @@unique([courseTypeId, name])
  @@index([courseTypeId, active])
  @@map("course_levels")
}

model CourseLevelTranslation {
  id            Int         @id @default(autoincrement())
  courseLevelId Int         @map("course_level_id")
  locale        String
  name          String

  courseLevel   CourseLevel @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)

  @@unique([courseLevelId, locale])
  @@index([locale])
  @@map("course_level_translations")
}

model Course {
  id              Int                  @id @default(autoincrement())
  slug            String               @unique
  courseTypeId    Int                  @map("course_type_id")
  courseLevelId   Int                  @map("course_level_id")
  durationMonths  Int                  @map("duration_months")
  totalSessions   Int                  @map("total_sessions")
  status          CourseStatus         @default(OPEN)
  sortOrder       Int                  @default(0) @map("sort_order")
  iconUrl         String?              @map("icon_url")
  priceVnd        Int?                 @map("price_vnd")
  discountPercent Int?                 @map("discount_percent")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  courseType      CourseType           @relation(fields: [courseTypeId], references: [id])
  courseLevel     CourseLevel          @relation(fields: [courseLevelId], references: [id])
  enrollments     Enrollment[]
  translations    CourseTranslation[]

  @@index([courseTypeId, status])
  @@index([courseLevelId, status])
  @@index([sortOrder, status])
  @@map("courses")
}

model CourseTranslation {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  locale    String
  title     String
  label     String
  target    String
  outcome   String
  syllabus  String[]
  roadmap   String?

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
  @@index([locale])
  @@map("course_translations")
}

model NewsArticleCategory {
  id           Int                              @id @default(autoincrement())
  iconUrl      String?                          @map("icon_url")
  sortOrder    Int                              @default(0) @map("sort_order")
  active       Boolean                          @default(true)
  createdAt    DateTime                         @default(now()) @map("created_at")
  updatedAt    DateTime                         @updatedAt @map("updated_at")

  articles     NewsArticle[]
  translations NewsArticleCategoryTranslation[]

  @@map("news_article_categories")
}

model NewsArticleCategoryTranslation {
  id         Int                 @id @default(autoincrement())
  categoryId Int                 @map("category_id")
  locale     String
  name       String

  category   NewsArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("news_article_category_translations")
}

model NewsTags {
  id           Int                   @id @default(autoincrement())
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  articleLinks NewsArticleTag[]
  translations NewsTagsTranslation[]

  @@map("news_tags")
}

model NewsTagsTranslation {
  id        Int      @id @default(autoincrement())
  newsTagId Int      @map("news_tag_id")
  locale    String
  name      String

  newsTag   NewsTags @relation(fields: [newsTagId], references: [id], onDelete: Cascade)

  @@unique([newsTagId, locale])
  @@index([locale])
  @@map("news_tag_translations")
}

model NewsArticle {
  id          Int                 @id @default(autoincrement())
  slug        String              @unique
  coverImage  String              @map("cover_image")
  gallery     String[]            @default([])
  categoryId  Int                 @map("category_id")
  author      String
  status      NewsStatus          @default(PUBLISHED)
  prominent   Boolean             @default(false)
  viewCount   Int                 @default(0) @map("view_count")
  publishedAt DateTime            @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  category    NewsArticleCategory @relation(fields: [categoryId], references: [id])
  tagLinks    NewsArticleTag[]
  translations NewsArticleTranslation[]

  @@index([categoryId, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([prominent, status])
  @@map("news_articles")
}

model NewsArticleTag {
  newsArticleId Int         @map("news_article_id")
  newsTagId     Int         @map("news_tag_id")
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  newsTag       NewsTags    @relation(fields: [newsTagId], references: [id], onDelete: Cascade)

  @@id([newsArticleId, newsTagId])
  @@index([newsTagId])
  @@map("news_article_tags")
}

model NewsArticleTranslation {
  id            Int         @id @default(autoincrement())
  newsArticleId Int         @map("news_article_id")
  locale        String
  title         String
  excerpt       String
  content       String      @db.Text

  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)

  @@unique([newsArticleId, locale])
  @@index([locale])
  @@map("news_article_translations")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String   @db.Text
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feedback")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  type      EnrollmentType
  courseId  Int              @map("course_id")
  name      String
  phone     String
  email     String?
  note      String?          @db.Text
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  course    Course           @relation(fields: [courseId], references: [id])

  @@index([type, status])
  @@index([courseId, status])
  @@index([createdAt(sort: Desc)])
  @@map("enrollments")
}

model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  address   String
  phone     String?
  mapUrl    String?  @map("map_url")
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@index([username, active])
  @@map("users")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
