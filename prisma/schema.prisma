generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CourseStatus {
  HIDDEN
  PUBLISHED
}

enum NewsStatus {
  HIDDEN
  PUBLISHED
}

enum EnrollmentType {
  TRIAL
  REAL
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserRole {
  ADMIN
  STAFF
}

model CourseCategory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courses      Course[]
  translations CourseCategoryTranslation[]

  @@map("course_categories")
}

model CourseCategoryTranslation {
  id         Int    @id @default(autoincrement())
  categoryId Int    @map("category_id")
  locale     String
  name       String

  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("course_category_translations")
}

model CourseLevel {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courses      Course[]
  translations CourseLevelTranslation[]

  @@map("course_levels")
}

model CourseLevelTranslation {
  id            Int    @id @default(autoincrement())
  courseLevelId Int    @map("course_level_id")
  locale        String
  name          String

  courseLevel CourseLevel @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)

  @@unique([courseLevelId, locale])
  @@index([locale])
  @@map("course_level_translations")
}

model Course {
  id         Int          @id @default(autoincrement())
  categoryId Int          @map("category_id")
  levelId    Int          @map("level_id")
  status     CourseStatus @default(HIDDEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  category     CourseCategory      @relation(fields: [categoryId], references: [id])
  level        CourseLevel         @relation(fields: [levelId], references: [id])
  enrollments  Enrollment[]
  translations CourseTranslation[]

  @@index([categoryId, status])
  @@index([levelId, status])
  @@map("courses")
}

model CourseTranslation {
  id       Int    @id @default(autoincrement())
  courseId Int    @map("course_id")
  locale   String
  title    String
  duration String
  content  String @db.Text

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
  @@index([locale])
  @@map("course_translations")
}

model NewsArticle {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  coverImage  String     @map("cover_image")
  gallery     String[]   @default([])
  status      NewsStatus @default(HIDDEN)
  publishedAt DateTime   @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  translations NewsArticleTranslation[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("news_articles")
}

model NewsArticleTranslation {
  id            Int    @id @default(autoincrement())
  newsArticleId Int    @map("news_article_id")
  locale        String
  title         String
  content       String @db.Text

  newsArticle NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)

  @@unique([newsArticleId, locale])
  @@index([locale])
  @@map("news_article_translations")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String   @db.Text
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feedback")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  type      EnrollmentType
  courseId  Int              @map("course_id")
  name      String
  phone     String
  email     String?
  note      String?          @db.Text
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])

  @@index([type, status])
  @@index([courseId, status])
  @@index([createdAt(sort: Desc)])
  @@map("enrollments")
}

model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  address   String
  phone     String?
  mapUrl    String?  @map("map_url")
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  name         String
  email        String?    @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(STAFF)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@index([username, active])
  @@map("users")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
