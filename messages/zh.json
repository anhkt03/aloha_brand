          "cost": {
            "q": "留学一年平均需要多少费用？",
            "a": "视国家而定：台湾约80–200万越南盾/年，韩国120–280万，日本180–320万，新加坡300–650万，欧洲200–500万。通过奖学金可大幅降低费用。"
          },
          "timing": {
            "q": "应该提前多久开始准备申请材料？",
            "a": "理想情况下建议提前12–18个月准备。ALOHA会根据您的能力为您量身制定详细规划。"
          },
          "language": {
            "q": "最低语言要求是什么？",
            "a": "台湾：HSK 4级以上或TOCFL A2；韩国：TOPIK 3级以上（D-2）；日本：大多数学校要求JLPT N3；新加坡与欧洲：雅思6.0–6.5分以上。"
          },
          "scholarshipSupport": {
            "q": "ALOHA是否协助申请奖学金？",
            "a": "是的。ALOHA与台湾政府奖学金、GKS（韩国）、MEXT（日本）、伊拉斯谟+（欧洲）等奖学金项目合作，全程协助材料准备与面试，直到获得结果。"
          },
          "workAfter": {
            "q": "毕业后可以留下来工作吗？",
            "a": "可以：台湾（毕业后工作签证）、韩国（D-10 → E-7）、日本（工程师/工作签证）、新加坡（Employment Pass）、欧洲（视国家而定）。ALOHA会为您提供具体规划建议。"
          },
          "noLanguageYet": {
            "q": "完全没有语言基础可以留学吗？",
            "a": "可以。ALOHA提供6–12个月的国内语言预备课程，也可以选择在国外进行为期1年的预科项目。"
          }
        }
